{
  "dependencies": [
    "catch2",
    {
      "name": "cpp-httplib",
      "default-features": false
    },
    "glm",
    {
      "name": "imgui",
      "features": [
        "sdl3-binding"
      ]
    },
    "imguizmo",
    "joltphysics",
    "libvorbis",
    "nlohmann-json",
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    "spdlog",
    "volk",
    "tinygltf",
    "vulkan-memory-allocator"
  ],
  "features": {
    "town-model": {
      "description": "The living town's built-in language model (llama.cpp); without it residents use rules and template lines",
      "dependencies": [
        "llama-cpp"
      ]
    },
    "town-model-gpu": {
      "description": "Runs the town's model on the graphics card through Vulkan (needs the Vulkan SDK; builds shaderc once)",
      "dependencies": [
        "llama-cpp",
        {
          "name": "ggml",
          "features": [
            "vulkan"
          ]
        }
      ]
    }
  }
}
