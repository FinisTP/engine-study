{
  "format": "umbra.ui", "version": 1, "modal": true,
  "root": { "type": "stack", "anchor": "bottom-right", "offset": [-24, -24], "style": "panel", "size": [300, 0], "align": "stretch", "gap": 8, "children": [
    { "type": "text", "style": "heading", "text": "Round {fight.round} - your turn" },
    { "type": "button", "text": "Attack", "action": "attack" },
    { "type": "button", "text": "Item", "action": "items", "disabled": "{fight.noItems}" },
    { "type": "button", "text": "Flee", "action": "flee" }
  ] }
}
