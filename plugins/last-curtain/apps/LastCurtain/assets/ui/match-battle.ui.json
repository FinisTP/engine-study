{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "root": {
    "type": "panel",
    "anchor": "fill",
    "style": "layer",
    "children": [
      {
        "type": "stack",
        "anchor": "top",
        "offset": [
          0,
          36
        ],
        "style": "plain",
        "gap": 4,
        "align": "center",
        "children": [
          {
            "type": "text",
            "style": "title",
            "text": "{battle.title}"
          },
          {
            "type": "text",
            "style": "blow",
            "text": "{battle.line}",
            "visible": "{battle.line}"
          }
        ]
      },
      {
        "type": "list",
        "anchor": "bottom-left",
        "offset": [
          30,
          -120
        ],
        "items": "{battle.mine}",
        "as": "f",
        "gap": 10,
        "entry": {
          "type": "stack",
          "style": "fighterCard",
          "direction": "horizontal",
          "gap": 10,
          "align": "center",
          "size": [
            270,
            0
          ],
          "children": [
            {
              "type": "image",
              "image": "{f.portrait}",
              "fit": "top",
              "size": [
                72,
                72
              ]
            },
            {
              "type": "stack",
              "style": "plain",
              "gap": 3,
              "children": [
                {
                  "type": "stack",
                  "style": "plain",
                  "direction": "horizontal",
                  "gap": 6,
                  "align": "center",
                  "children": [
                    {
                      "type": "text",
                      "style": "tagName",
                      "text": "{f.name}"
                    },
                    {
                      "type": "text",
                      "style": "tagLevel",
                      "text": "Lv {f.level}"
                    }
                  ]
                },
                {
                  "type": "bar",
                  "style": "hp",
                  "size": [
                    150,
                    8
                  ],
                  "value": "{f.hp}",
                  "max": "{f.maxHp}"
                },
                {
                  "type": "text",
                  "style": "tagNum",
                  "text": "HP {f.hp}/{f.maxHp}"
                },
                {
                  "type": "text",
                  "style": "good",
                  "text": "{words.shield} {f.shield}",
                  "visible": "{f.shield}"
                }
              ]
            }
          ],
          "selected": "{f.picking}"
        }
      },
      {
        "type": "list",
        "anchor": "bottom-right",
        "offset": [
          -30,
          -120
        ],
        "items": "{battle.theirs}",
        "as": "f",
        "gap": 10,
        "entry": {
          "type": "stack",
          "style": "fighterCard",
          "direction": "horizontal",
          "gap": 10,
          "align": "center",
          "size": [
            270,
            0
          ],
          "children": [
            {
              "type": "image",
              "image": "{f.portrait}",
              "fit": "top",
              "size": [
                72,
                72
              ]
            },
            {
              "type": "stack",
              "style": "plain",
              "gap": 3,
              "children": [
                {
                  "type": "stack",
                  "style": "plain",
                  "direction": "horizontal",
                  "gap": 6,
                  "align": "center",
                  "children": [
                    {
                      "type": "text",
                      "style": "tagName",
                      "text": "{f.name}"
                    },
                    {
                      "type": "text",
                      "style": "tagLevel",
                      "text": "Lv {f.level}"
                    }
                  ]
                },
                {
                  "type": "bar",
                  "style": "hp",
                  "size": [
                    150,
                    8
                  ],
                  "value": "{f.hp}",
                  "max": "{f.maxHp}"
                },
                {
                  "type": "text",
                  "style": "tagNum",
                  "text": "HP {f.hp}/{f.maxHp}"
                },
                {
                  "type": "text",
                  "style": "good",
                  "text": "{words.shield} {f.shield}",
                  "visible": "{f.shield}"
                }
              ]
            }
          ],
          "selected": "{f.picking}"
        }
      },
      {
        "type": "stack",
        "anchor": "bottom",
        "offset": [
          0,
          -28
        ],
        "style": "float",
        "gap": 6,
        "align": "center",
        "visible": "{battle.picks}",
        "children": [
          {
            "type": "list",
            "items": "{battle.picks}",
            "as": "p",
            "direction": "horizontal",
            "gap": 8,
            "entry": {
              "type": "stack",
              "direction": "horizontal",
              "gap": 6,
              "align": "center",
              "children": [
                {
                  "type": "image",
                  "image": "{p.icon}",
                  "size": [
                    28,
                    28
                  ]
                },
                {
                  "type": "button",
                  "style": "act",
                  "size": [
                    0,
                    0
                  ],
                  "text": "{p.label}   {p.dealtText}",
                  "action": "pick",
                  "arg": "{p.slot}",
                  "disabled": "{p.off}",
                  "tip": "{p.tip}"
                },
                {
                  "type": "text",
                  "style": "bad",
                  "text": "{p.costText}",
                  "visible": "{p.costText}"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "text",
        "anchor": "bottom",
        "offset": [
          0,
          -150
        ],
        "style": "lcToast",
        "text": "{tip}",
        "visible": "{tip}",
        "wrap": true,
        "size": [
          760,
          0
        ]
      },
      {
        "type": "list",
        "items": "{pops}",
        "as": "n",
        "entry": {
          "type": "stack",
          "at": "{n.at}",
          "children": [
            {
              "type": "text",
              "style": "alarm",
              "text": "{n.text}",
              "visible": "{n.hurt}"
            },
            {
              "type": "text",
              "style": "good",
              "text": "{n.text}",
              "visible": "{n.heal}"
            }
          ]
        }
      }
    ]
  }
}
