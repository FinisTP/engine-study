{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "root": { "type": "stack", "anchor": "center", "style": "float", "gap": 12, "align": "center", "size": [820, 0], "children": [
    { "type": "text", "style": "title", "text": "{battle.title}" },
    { "type": "list", "items": "{battle.fighters}", "as": "f", "direction": "horizontal", "gap": 60,
      "entry": { "type": "stack", "style": "plain", "gap": 4, "align": "center", "size": [300, 0], "children": [
        { "type": "image", "image": "{f.portrait}", "fit": "top", "size": [120, 120] },
        { "type": "text", "style": "heading", "text": "{f.name}   Lv {f.level}" },
        { "type": "bar", "style": "hp", "size": [240, 10], "value": "{f.hp}", "max": "{f.maxHp}" },
        { "type": "text", "style": "small", "text": "HP {f.hp}/{f.maxHp}" },
        { "type": "text", "style": "good", "text": "Shield {f.shield}", "visible": "{f.shield}" }
      ] } },
    { "type": "text", "style": "blow", "text": "{battle.line}", "visible": "{battle.line}" },
    { "type": "list", "items": "{battle.picks}", "as": "p", "gap": 6, "visible": "{battle.picks}",
      "entry": { "type": "button", "style": "act", "size": [420, 0], "text": "{p.label}   {p.dealtMin}-{p.dealtMax}   cost {p.cost} HP", "action": "pick", "arg": "{p.slot}",
                 "disabled": "{p.off}", "tip": "{p.why}" } },
    { "type": "text", "style": "warning", "text": "{tip}", "visible": "{tip}" }
  ] }
}
