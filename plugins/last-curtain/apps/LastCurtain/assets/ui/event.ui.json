{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "root": { "type": "stack", "anchor": "center", "style": "panel", "size": [720, 0], "align": "stretch", "gap": 12, "children": [
    { "type": "text", "style": "muted", "text": "EVENT  |  {event.room}" },
    { "type": "text", "style": "title", "text": "{event.name}" },
    { "type": "text", "style": "text", "text": "{event.text}", "wrap": true, "size": [680, 0] },
    { "type": "text", "style": "strong", "text": "Roll {event.stat}: d20 + {event.statValue} against {event.target}   |   {event.chance}% chance" },
    { "type": "text", "style": "good", "text": "Pass: {event.pass}" },
    { "type": "text", "style": "bad", "text": "Fail: {event.fail}" },
    { "type": "button", "size": [200, 44], "text": "Roll", "action": "roll" }
  ] }
}
