{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "root": { "type": "stack", "anchor": "right", "offset": [-24, 20], "style": "panel", "size": [440, 0], "align": "stretch", "gap": 12, "children": [
    { "type": "stack", "align": "center", "children": [ { "type": "image", "image": "{event.picture}", "size": [220, 220] } ] },
    { "type": "text", "style": "muted", "text": "{event.kind}  |  {event.room}" },
    { "type": "text", "style": "title", "text": "{event.name}" },
    { "type": "text", "style": "text", "text": "{event.text}", "wrap": true, "size": [400, 0] },
    { "type": "text", "style": "warning", "text": "{event.lasting}", "visible": "{event.lasting}", "wrap": true, "size": [400, 0] },
    { "type": "text", "style": "good", "text": "{event.cleared}", "visible": "{event.cleared}", "wrap": true, "size": [400, 0] },
    { "type": "text", "style": "strong", "text": "A {event.stat} roll: d20 + your {event.stat} {event.statValue}, needing {event.target} or more   |   {event.chance}% chance", "visible": "{event.rolls}", "wrap": true, "size": [400, 0] },
    { "type": "text", "style": "good", "text": "If you pass: {event.pass}", "visible": "{event.rolls}" },
    { "type": "text", "style": "bad", "text": "If you fail: {event.fail}", "visible": "{event.rolls}" },
    { "type": "stack", "align": "center", "children": [ { "type": "button", "size": [200, 44], "text": "{event.button}", "action": "roll" } ] }
  ] }
}
