{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "root": {
    "type": "panel",
    "anchor": "fill",
    "style": "layer",
    "children": [
      {
        "type": "image",
        "anchor": "fill",
        "image": "art/ui/match/backdrop.jpg",
        "fit": "cover"
      },
      {
        "type": "stack",
        "anchor": "center",
        "style": "float",
        "size": [
          1120,
          0
        ],
        "align": "stretch",
        "gap": 14,
        "children": [
          {
            "type": "text",
            "style": "title",
            "text": "The Last Curtain"
          },
          {
            "type": "text",
            "style": "small",
            "text": "Pick {pick.side} for your side ({pick.count} chosen). The house picks the other side.",
            "wrap": true,
            "size": [
              1080,
              0
            ]
          },
          {
            "type": "list",
            "items": "{pick.characters}",
            "as": "c",
            "columns": 5,
            "gap": 10,
            "action": "pick",
            "arg": "{c.id}",
            "entry": {
              "type": "stack",
              "style": "slot",
              "size": [
                206,
                0
              ],
              "gap": 4,
              "align": "center",
              "selected": "{c.picked}",
              "children": [
                {
                  "type": "text",
                  "style": "chosen",
                  "text": "Chosen",
                  "visible": "{c.picked}"
                },
                {
                  "type": "image",
                  "image": "{c.portrait}",
                  "fit": "top",
                  "size": [
                    110,
                    110
                  ]
                },
                {
                  "type": "text",
                  "style": "strong",
                  "text": "{c.name}",
                  "wrap": true,
                  "size": [
                    190,
                    0
                  ]
                },
                {
                  "type": "text",
                  "style": "muted",
                  "text": "{c.role}"
                },
                {
                  "type": "text",
                  "style": "small",
                  "text": "HP {c.hp}  ATK {c.attack}  DEF {c.defence}"
                },
                {
                  "type": "text",
                  "style": "small",
                  "text": "Speed {c.speed}  Move {c.move}"
                }
              ]
            }
          },
          {
            "type": "stack",
            "direction": "horizontal",
            "gap": 12,
            "align": "center",
            "children": [
              {
                "type": "text",
                "style": "small",
                "text": "Bots"
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  110,
                  40
                ],
                "text": "Easy",
                "action": "level",
                "arg": "easy",
                "selected": "{pick.easy}"
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  110,
                  40
                ],
                "text": "Medium",
                "action": "level",
                "arg": "medium",
                "selected": "{pick.medium}"
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  110,
                  40
                ],
                "text": "Hard",
                "action": "level",
                "arg": "hard",
                "selected": "{pick.hard}"
              }
            ]
          },
          {
            "type": "stack",
            "direction": "horizontal",
            "gap": 12,
            "children": [
              {
                "type": "button",
                "style": "act",
                "size": [
                  200,
                  44
                ],
                "text": "Start",
                "action": "start",
                "visible": "{pick.canStart}"
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  200,
                  44
                ],
                "text": "Start",
                "action": "start",
                "disabled": "{pick.cannotStart}",
                "visible": "{pick.cannotStart}",
                "tip": "Pick {pick.side} for your side first."
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  200,
                  44
                ],
                "text": "Continue",
                "action": "continue",
                "visible": "{pick.canContinue}"
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  200,
                  44
                ],
                "text": "Quit",
                "action": "quit",
                "visible": "{single}"
              },
              {
                "type": "button",
                "style": "act",
                "size": [
                  240,
                  44
                ],
                "text": "Back to the cafe",
                "action": "cafe",
                "visible": "{career}"
              }
            ]
          }
        ]
      }
    ]
  }
}
