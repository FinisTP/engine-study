{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "back": "close",
  "root": {
    "type": "stack",
    "anchor": "center",
    "style": "lcPanel",
    "size": [
      1200,
      660
    ],
    "gap": 14,
    "children": [
      {
        "type": "stack",
        "direction": "horizontal",
        "gap": 22,
        "align": "center",
        "children": [
          {
            "type": "text",
            "style": "title",
            "text": "{words.notebook}"
          },
          {
            "type": "stack",
            "direction": "horizontal",
            "gap": 4,
            "children": [
              {
                "type": "button",
                "style": "lcButton",
                "text": "{words.tabCharacters}",
                "action": "tab",
                "arg": "characters"
              },
              {
                "type": "button",
                "style": "lcButton",
                "text": "{words.tabIngredients}",
                "action": "tab",
                "arg": "ingredients"
              },
              {
                "type": "button",
                "style": "lcButton",
                "text": "{words.tabKeepsakes}",
                "action": "tab",
                "arg": "keepsakes"
              }
            ]
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{words.readOnly}",
            "visible": "{book.readOnly}"
          }
        ]
      },
      {
        "type": "text",
        "style": "lcToast",
        "text": "{book.lesson}",
        "visible": "{book.lesson}",
        "wrap": true,
        "size": [
          1100,
          0
        ]
      },
      {
        "type": "stack",
        "direction": "horizontal",
        "gap": 22,
        "children": [
          {
            "type": "list",
            "items": "{book.entries}",
            "as": "e",
            "gap": 4,
            "entry": {
              "type": "button",
              "style": "lcButton",
              "text": "{e.name}",
              "action": "select",
              "arg": "{e.id}",
              "selected": "{e.selected}",
              "size": [
                200,
                0
              ]
            }
          },
          {
            "type": "stack",
            "size": [
              440,
              0
            ],
            "gap": 10,
            "visible": "{book.detail.portrait}",
            "children": [
              {
                "type": "stack",
                "direction": "horizontal",
                "gap": 14,
                "align": "center",
                "children": [
                  {
                    "type": "image",
                    "image": "{book.detail.portrait}",
                    "size": [
                      76,
                      76
                    ],
                    "fit": "top"
                  },
                  {
                    "type": "stack",
                    "gap": 3,
                    "children": [
                      {
                        "type": "text",
                        "style": "heading",
                        "text": "{book.selectedName}"
                      },
                      {
                        "type": "text",
                        "style": "muted",
                        "text": "{book.detail.levelText}"
                      },
                      {
                        "type": "text",
                        "style": "small",
                        "text": "{book.detail.statsText}"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "button",
                "style": "lcButton",
                "text": "{book.detail.fightText}",
                "action": "fight",
                "disabled": "{book.detail.locked}",
                "selected": "{book.detail.fights}",
                "size": [
                  300,
                  0
                ]
              },
              {
                "type": "text",
                "style": "heading",
                "text": "{book.detail.carriedTitle}"
              },
              {
                "type": "list",
                "items": "{book.detail.loadout}",
                "as": "k",
                "columns": 2,
                "gap": 5,
                "entry": {
                  "type": "button",
                  "style": "lcButton",
                  "text": "{k.name}",
                  "action": "pick",
                  "arg": "skill:{k.index}",
                  "selected": "{k.picked}",
                  "size": [
                    212,
                    0
                  ]
                }
              },
              {
                "type": "text",
                "style": "heading",
                "text": "{words.bag}"
              },
              {
                "type": "list",
                "items": "{book.detail.slots}",
                "as": "s",
                "columns": 4,
                "gap": 6,
                "entry": {
                  "type": "stack",
                  "style": "lcButton",
                  "action": "pick",
                  "arg": "bag:{s.slot}",
                  "align": "center",
                  "size": [
                    100,
                    74
                  ],
                  "gap": 2,
                  "children": [
                    {
                      "type": "image",
                      "image": "{s.icon}",
                      "size": [
                        40,
                        40
                      ],
                      "visible": "{s.icon}"
                    },
                    {
                      "type": "text",
                      "style": "small",
                      "text": "{s.label}"
                    }
                  ],
                  "selected": "{s.picked}"
                }
              },
              {
                "type": "text",
                "style": "muted",
                "text": "{words.memoriesLabel} {book.detail.memoryCount}"
              }
            ]
          },
          {
            "type": "stack",
            "size": [
              440,
              0
            ],
            "gap": 8,
            "visible": "{book.detail.portrait}",
            "children": [
              {
                "type": "stack",
                "style": "lcPanel",
                "gap": 6,
                "size": [
                  440,
                  0
                ],
                "visible": "{book.detail.card}",
                "children": [
                  {
                    "type": "text",
                    "style": "heading",
                    "text": "{book.detail.card.name}",
                    "visible": "{book.detail.card.name}"
                  },
                  {
                    "type": "text",
                    "style": "text",
                    "text": "{book.detail.card.lore}",
                    "wrap": true,
                    "size": [
                      400,
                      0
                    ],
                    "visible": "{book.detail.card.lore}"
                  },
                  {
                    "type": "text",
                    "style": "muted",
                    "text": "{book.detail.card.text}",
                    "wrap": true,
                    "size": [
                      400,
                      0
                    ],
                    "visible": "{book.detail.card.text}"
                  },
                  {
                    "type": "text",
                    "style": "warning",
                    "text": "{book.detail.card.hint}",
                    "wrap": true,
                    "size": [
                      400,
                      0
                    ],
                    "visible": "{book.detail.card.hint}"
                  },
                  {
                    "type": "list",
                    "items": "{book.detail.skill.versions}",
                    "as": "v",
                    "gap": 4,
                    "entry": {
                      "type": "text",
                      "style": "small",
                      "text": "{words.upgrades}: {v.name}"
                    }
                  },
                  {
                    "type": "stack",
                    "direction": "horizontal",
                    "gap": 8,
                    "children": [
                      {
                        "type": "button",
                        "style": "lcButton",
                        "text": "{words.take}",
                        "action": "take",
                        "visible": "{book.detail.card.take}"
                      },
                      {
                        "type": "button",
                        "style": "lcButton",
                        "text": "{words.drop}",
                        "action": "drop",
                        "visible": "{book.detail.card.drop}"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "text",
                "style": "heading",
                "text": "{words.stockSkills}",
                "visible": "{book.detail.learned}"
              },
              {
                "type": "list",
                "items": "{book.detail.learned}",
                "as": "l",
                "columns": 2,
                "gap": 5,
                "entry": {
                  "type": "button",
                  "style": "lcButton",
                  "text": "{l.name}",
                  "action": "pick",
                  "arg": "learned:{l.id}",
                  "selected": "{l.picked}",
                  "size": [
                    212,
                    0
                  ]
                }
              },
              {
                "type": "text",
                "style": "heading",
                "text": "{words.lockedSkills}",
                "visible": "{book.detail.locked}"
              },
              {
                "type": "list",
                "items": "{book.detail.locked}",
                "as": "l",
                "gap": 5,
                "entry": {
                  "type": "button",
                  "style": "lcToggle",
                  "text": "{l.name} · {l.when}",
                  "action": "pick",
                  "arg": "locked:{l.id}",
                  "selected": "{l.picked}",
                  "size": [
                    430,
                    0
                  ]
                }
              },
              {
                "type": "text",
                "style": "heading",
                "text": "{words.storeTitle}",
                "visible": "{book.detail.store}"
              },
              {
                "type": "list",
                "items": "{book.detail.store}",
                "as": "t",
                "columns": 1,
                "gap": 5,
                "entry": {
                  "type": "stack",
                  "direction": "horizontal",
                  "gap": 4,
                  "align": "center",
                  "children": [
                    {
                      "type": "image",
                      "image": "{t.icon}",
                      "size": [
                        28,
                        28
                      ],
                      "visible": "{t.icon}"
                    },
                    {
                      "type": "button",
                      "style": "lcButton",
                      "text": "{t.name}",
                      "action": "pick",
                      "arg": "store:{t.id}",
                      "selected": "{t.picked}",
                      "size": [
                        390,
                        0
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "stack",
            "gap": 6,
            "visible": "{book.detail.count}",
            "children": [
              {
                "type": "text",
                "style": "text",
                "text": "{words.count} {book.detail.count}"
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.close}",
        "action": "close",
        "size": [
          200,
          0
        ]
      }
    ]
  }
}
