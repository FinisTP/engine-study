{
  "format": "umbra.ui",
  "version": 1,
  "root": { "type": "panel", "anchor": "fill", "style": "layer", "visible": "{noScene}", "children": [
    { "type": "stack", "anchor": "top", "style": "hud", "direction": "horizontal", "gap": 28, "size": [1280, 52], "align": "center", "children": [
      { "type": "text", "style": "title", "text": "{clock}" },
      { "type": "text", "style": "small", "text": "Night {night}  |  Round {round} of {rounds}  |  {phase}" },
      { "type": "spacer", "size": [120, 0] },
      { "type": "list", "items": "{topList}", "as": "p", "action": "focus", "entry": { "type": "image", "image": "{p.portrait}", "size": [44, 44] } },
      { "type": "text", "style": "heading", "text": "{top.name}  Lv {top.level}" },
      { "type": "text", "style": "strong", "text": "HP {top.hp}/{top.maxHp}   Might {top.might}   Sanity {top.sanity}   Speed {top.speed}" },
      { "type": "text", "style": "warning", "text": "THEIR TURN", "visible": "{top.theirs}" },
      { "type": "text", "style": "bad", "text": "YOU ARE A GHOST", "visible": "{me.ghost}" },
      { "type": "text", "style": "bad", "text": "YOU ARE DOWN", "visible": "{me.down}" },
    { "type": "text", "style": "small", "text": "You: HP {me.hp}/{me.maxHp}", "visible": "{top.theirs}" },
    { "type": "text", "style": "bad", "text": "{me.flash}", "visible": "{me.flash}" },
    { "type": "text", "style": "good", "text": "{me.buffs}", "visible": "{me.buffs}" }
    ] },
    { "type": "stack", "anchor": "top", "offset": [0, 70], "style": "panel", "direction": "horizontal", "gap": 14, "align": "center", "visible": "{banner}", "children": [
      { "type": "image", "image": "{banner.portrait}", "size": [64, 64] },
      { "type": "text", "style": "title", "text": "Your turn", "visible": "{banner.yours}" },
      { "type": "text", "style": "title", "text": "{banner.name}'s turn", "visible": "{banner.theirs}" }
    ] },
    { "type": "button", "anchor": "top-left", "offset": [24, 76], "size": [300, 40], "text": "Quests  +", "action": "goals", "visible": "{goalFolded}" },
    { "type": "stack", "anchor": "top-left", "offset": [24, 76], "style": "panel", "gap": 6, "size": [300, 0], "visible": "{goalOpen}", "children": [
      { "type": "button", "size": [270, 34], "text": "Quests  -", "action": "goals" },
      { "type": "text", "style": "muted", "text": "First to finish one wins its power.", "wrap": true, "size": [270, 0] },
      { "type": "list", "items": "{openQuests}", "as": "q", "gap": 8, "entry": { "type": "stack", "gap": 2, "children": [
        { "type": "text", "style": "strong", "text": "{q.name}" },
        { "type": "text", "style": "small", "text": "{q.text}", "wrap": true, "size": [270, 0] },
        { "type": "text", "style": "good", "text": "Reward: {q.reward}", "wrap": true, "size": [270, 0] }
      ] } },
      { "type": "list", "items": "{takenQuests}", "as": "q", "entry": { "type": "text", "style": "muted", "text": "{q.name}: taken by {q.by}" } },
      { "type": "text", "style": "heading", "text": "Your power: {power.name}", "visible": "{power}" },
      { "type": "text", "style": "small", "text": "Ready again in {power.cooldown} turns", "visible": "{power.cooldown}" }
    ] },
    { "type": "text", "anchor": "top", "offset": [0, 140], "style": "alarm", "text": "The killer is near. Run.", "visible": "{killerNear}" },
    { "type": "stack", "anchor": "top", "offset": [0, 84], "style": "obituary", "gap": 4, "visible": "{obituary}", "align": "center", "children": [
      { "type": "text", "style": "title", "text": "{obituary.title}" },
      { "type": "text", "style": "small", "text": "{obituary.cause}", "wrap": true, "size": [560, 0] }
    ] },
    { "type": "stack", "anchor": "top-right", "offset": [-24, 62], "direction": "horizontal", "gap": 6, "align": "center", "children": [
      { "type": "text", "style": "small", "text": "Turn order" },
      { "type": "list", "items": "{turnOrder}", "as": "t", "direction": "horizontal", "gap": 4,
        "entry": { "type": "stack", "style": "slot", "selected": "{t.now}", "disabled": "{t.dead}", "children": [ { "type": "image", "image": "{t.portrait}", "size": [30, 30] } ] } }
    ] },
    { "type": "button", "anchor": "bottom-right", "offset": [-24, -60], "size": [140, 44], "text": "Skip", "action": "skip", "visible": "{canSkip}" },
    { "type": "button", "anchor": "bottom-right", "offset": [-24, -116], "size": [140, 44], "text": "{view}", "action": "look", "visible": "{canView}" },
    { "type": "list", "anchor": "top-right", "offset": [-16, 64], "items": "{warnings}", "as": "w", "visible": "{warnings}",
      "entry": { "type": "text", "style": "warning", "text": "{w}", "wrap": true, "size": [460, 0] } },
    { "type": "text", "anchor": "bottom-left", "offset": [24, -18], "style": "muted",
      "text": "Click: walk, talk, take, fight   Right-click: inspect   Drag: look   Wheel: zoom   Esc: menu" }
  ] }
}
