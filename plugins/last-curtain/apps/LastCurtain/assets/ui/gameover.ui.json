{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "back": "retry",
  "root": {
    "type": "stack",
    "anchor": "center",
    "style": "lcPanel",
    "size": [
      700,
      0
    ],
    "gap": 10,
    "children": [
      {
        "type": "text",
        "style": "title",
        "text": "{words.gameOver}"
      },
      {
        "type": "text",
        "style": "small",
        "text": "{over.reasonText}"
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.retry}",
        "action": "retry"
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.rite}",
        "action": "rite",
        "visible": "{over.rite}"
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.toMap}",
        "action": "map",
        "visible": "{over.notRetryOnly}"
      }
    ]
  }
}
