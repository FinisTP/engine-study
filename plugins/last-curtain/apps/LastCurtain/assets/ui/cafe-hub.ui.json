{
  "format": "umbra.ui",
  "version": 1,
  "root": {
    "type": "panel",
    "anchor": "fill",
    "style": "layer",
    "children": [
      {
        "type": "list",
        "items": "{room.labels}",
        "as": "l",
        "entry": {
          "type": "stack",
          "style": "plain",
          "align": "center",
          "at": "{l.at}",
          "children": [
            {
              "type": "button",
              "style": "lcPlate",
              "text": "{l.name}",
              "action": "talk",
              "arg": "{l.who}",
              "selected": "{l.talk}"
            }
          ]
        }
      },
      {
        "type": "stack",
        "anchor": "top-left",
        "offset": [
          24,
          20
        ],
        "style": "lcPanel",
        "gap": 6,
        "size": [
          380,
          0
        ],
        "children": [
          {
            "type": "text",
            "style": "heading",
            "text": "{words.cafe}"
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{words.cafeHint}",
            "wrap": true,
            "size": [
              340,
              0
            ]
          },
          {
            "type": "text",
            "style": "mine",
            "text": "{words.walking} {room.who}"
          },
          {
            "type": "button",
            "style": "lcButton",
            "size": [
              300,
              0
            ],
            "text": "{words.switch}",
            "action": "switch"
          },
          {
            "type": "list",
            "items": "{hub.keepsakes}",
            "as": "k",
            "gap": 5,
            "entry": {
              "type": "button",
              "style": "lcButton",
              "size": [
                300,
                0
              ],
              "text": "{words.give} {k.name}",
              "action": "give",
              "arg": "{k.item}"
            }
          },
          {
            "type": "text",
            "style": "mine",
            "text": "{words.canBrew}",
            "visible": "{hub.canBrew}"
          },
          {
            "type": "button",
            "style": "lcButton",
            "size": [
              300,
              0
            ],
            "text": "{words.brew}",
            "action": "brew"
          },
          {
            "type": "button",
            "style": "lcButton",
            "size": [
              300,
              0
            ],
            "text": "{words.notebook}",
            "action": "notebook"
          },
          {
            "type": "button",
            "style": "lcButton",
            "size": [
              300,
              0
            ],
            "text": "{words.settings}",
            "action": "settings"
          },
          {
            "type": "button",
            "style": "lcButton",
            "size": [
              300,
              0
            ],
            "text": "{words.door}",
            "action": "leave"
          }
        ]
      },
      {
        "type": "list",
        "anchor": "top-right",
        "offset": [
          -20,
          14
        ],
        "items": "{hub.toasts}",
        "as": "t",
        "gap": 4,
        "entry": {
          "type": "text",
          "style": "lcToast",
          "text": "{t.text}"
        }
      },
      {
        "type": "text",
        "anchor": "bottom",
        "offset": [
          0,
          -28
        ],
        "style": "lcToast",
        "text": "{room.prompt}",
        "visible": "{room.prompt}"
      }
    ]
  }
}
