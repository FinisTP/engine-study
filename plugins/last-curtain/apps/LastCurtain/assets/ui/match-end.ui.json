{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "root": { "type": "stack", "anchor": "center", "style": "panel", "gap": 12, "align": "center", "size": [620, 0], "children": [
    { "type": "text", "style": "title", "text": "{end.title}" },
    { "type": "stack", "direction": "horizontal", "gap": 40, "children": [
      { "type": "text", "style": "heading", "text": "Your side" },
      { "type": "text", "style": "heading", "text": "Their side" }
    ] },
    { "type": "list", "items": "{end.rows}", "as": "r", "gap": 4,
      "entry": { "type": "stack", "direction": "horizontal", "gap": 24, "children": [
        { "type": "text", "style": "small", "text": "{r.label}", "size": [220, 0] },
        { "type": "text", "style": "strong", "text": "{r.mine}", "size": [80, 0] },
        { "type": "text", "style": "strong", "text": "{r.theirs}", "size": [80, 0] }
      ] } },
    { "type": "stack", "direction": "horizontal", "gap": 12, "children": [
      { "type": "button", "size": [200, 44], "text": "Play again", "action": "again" },
      { "type": "button", "size": [200, 44], "text": "Quit", "action": "quit" }
    ] }
  ] }
}
