{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "back": "close",
  "root": {
    "type": "stack",
    "anchor": "center",
    "style": "lcPanel",
    "gap": 8,
    "size": [
      760,
      0
    ],
    "children": [
      {
        "type": "text",
        "style": "heading",
        "text": "{words.brew}"
      },
      {
        "type": "list",
        "items": "{hub.recipes}",
        "as": "r",
        "gap": 6,
        "entry": {
          "type": "stack",
          "gap": 3,
          "children": [
            {
              "type": "stack",
              "direction": "horizontal",
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "type": "image",
                  "image": "art/ui/campaign/item/{r.id}.png",
                  "size": [
                    52,
                    52
                  ]
                },
                {
                  "type": "button",
                  "style": "lcButton",
                  "size": [
                    620,
                    0
                  ],
                  "text": "{r.name}   {r.text}",
                  "action": "pick",
                  "arg": "{r.id}",
                  "disabled": "{r.off}"
                }
              ]
            },
            {
              "type": "list",
              "items": "{r.lacks}",
              "as": "l",
              "direction": "horizontal",
              "gap": 10,
              "entry": {
                "type": "stack",
                "direction": "horizontal",
                "gap": 4,
                "align": "center",
                "children": [
                  {
                    "type": "image",
                    "image": "art/ui/campaign/item/{l.item}.png",
                    "size": [
                      28,
                      28
                    ]
                  },
                  {
                    "type": "text",
                    "style": "warning",
                    "text": "{l.label}"
                  }
                ]
              }
            },
            {
              "type": "list",
              "items": "{r.versions}",
              "as": "v",
              "direction": "horizontal",
              "gap": 10,
              "entry": {
                "type": "text",
                "style": "small",
                "text": "{v.name}"
              }
            }
          ]
        }
      },
      {
        "type": "list",
        "items": "{hub.forWhom}",
        "as": "f",
        "direction": "horizontal",
        "gap": 8,
        "entry": {
          "type": "button",
          "style": "lcButton",
          "text": "{f.name}",
          "action": "for",
          "arg": "{f.who}"
        }
      },
      {
        "type": "button",
        "style": "lcButton",
        "size": [
          200,
          0
        ],
        "text": "{words.close}",
        "action": "close"
      }
    ]
  }
}
