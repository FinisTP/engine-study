{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "back": "back",
  "root": {
    "type": "stack",
    "anchor": "center",
    "style": "lcPanel",
    "size": [
      700,
      0
    ],
    "gap": 10,
    "children": [
      {
        "type": "text",
        "style": "title",
        "text": "{pre.title}"
      },
      {
        "type": "text",
        "style": "muted",
        "text": "{pre.levelLine}"
      },
      {
        "type": "text",
        "style": "small",
        "text": "{words.whoFights}"
      },
      {
        "type": "list",
        "items": "{pre.roster}",
        "as": "m",
        "gap": 4,
        "entry": {
          "type": "button",
          "style": "lcToggle",
          "size": [
            400,
            0
          ],
          "text": "{m.name}  {m.levelText}  ·  {m.stateText}",
          "action": "toggle",
          "arg": "{m.id}",
          "selected": "{m.in}"
        }
      },
      {
        "type": "text",
        "style": "warning",
        "text": "{words.reviveWarning}",
        "visible": "{pre.reviveWarning}"
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.editInNotebook}",
        "action": "notebook"
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.fight}",
        "action": "fight"
      },
      {
        "type": "button",
        "style": "lcButton",
        "text": "{words.back}",
        "action": "back"
      }
    ]
  }
}
