{
  "format": "umbra.ui",
  "version": 1,
  "root": { "type": "stack", "anchor": "bottom", "offset": [0, -52], "style": "panel", "size": [700, 0], "gap": 6, "children": [
    { "type": "text", "style": "good", "text": "{caption.guest}" },
    { "type": "text", "style": "heading", "text": "{caption.line}", "wrap": true, "size": [660, 0] },
    { "type": "text", "style": "warning", "text": "{caption.event}", "visible": "{caption.event}" },
    { "type": "text", "style": "small", "text": "{caption.eventText}", "visible": "{caption.eventText}", "wrap": true, "size": [660, 0] },
    { "type": "text", "style": "strong", "text": "{caption.saidBy}: \"{caption.said}\"", "visible": "{caption.said}", "wrap": true, "size": [660, 0] },
    { "type": "text", "style": "small", "text": "{caption.result}", "visible": "{caption.result}", "wrap": true, "size": [660, 0] },
    { "type": "button", "text": "Continue", "action": "next", "size": [160, 40], "visible": "{caption.tap}" },
    { "type": "text", "style": "muted", "text": "Click anywhere to go on   Skip: to your turn" }
  ] }
}
