{
  "format": "umbra.ui",
  "version": 1,
  "root": {
    "type": "panel",
    "anchor": "fill",
    "style": "layer",
    "children": [
      {
        "type": "stack",
        "anchor": "top-left",
        "offset": [
          20,
          14
        ],
        "style": "lcPanel",
        "gap": 4,
        "size": [
          260,
          0
        ],
        "children": [
          {
            "type": "text",
            "style": "muted",
            "text": "{hud.goals.title}"
          },
          {
            "type": "list",
            "items": "{hud.goals.lines}",
            "as": "g",
            "gap": 3,
            "entry": {
              "type": "stack",
              "direction": "horizontal",
              "gap": 6,
              "children": [
                {
                  "type": "panel",
                  "style": "tickOn",
                  "size": [
                    12,
                    12
                  ],
                  "visible": "{g.done}"
                },
                {
                  "type": "panel",
                  "style": "tickOff",
                  "size": [
                    12,
                    12
                  ],
                  "visible": "{g.open}"
                },
                {
                  "type": "text",
                  "style": "small",
                  "text": "{g.text}"
                }
              ],
              "align": "center"
            }
          },
          {
            "type": "text",
            "style": "warning",
            "text": "× {words.trapped}",
            "visible": "{hud.goals.failed}"
          },
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.retreat}",
            "action": "retreat"
          }
        ]
      },
      {
        "type": "list",
        "anchor": "top",
        "offset": [
          0,
          10
        ],
        "style": "lcPanel",
        "items": "{hud.strip}",
        "as": "o",
        "direction": "horizontal",
        "gap": 6,
        "entry": {
          "type": "stack",
          "style": "face",
          "gap": 1,
          "align": "center",
          "selected": "{o.acting}",
          "children": [
            {
              "type": "image",
              "image": "{o.portrait}",
              "fit": "top",
              "size": [
                44,
                44
              ],
              "visible": "{o.portrait}"
            },
            {
              "type": "text",
              "style": "small",
              "text": "{o.name}",
              "visible": "{o.mine}"
            },
            {
              "type": "text",
              "style": "warning",
              "text": "{o.name}",
              "visible": "{o.theirs}"
            }
          ]
        },
        "action": "focus",
        "arg": "{o.unit}"
      },
      {
        "type": "stack",
        "anchor": "bottom-left",
        "offset": [
          20,
          -14
        ],
        "style": "lcPanel",
        "gap": 3,
        "size": [
          620,
          0
        ],
        "children": [
          {
            "type": "text",
            "style": "small",
            "text": "{hud.hint}"
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{hud.logLine}",
            "visible": "{hud.logLine}"
          }
        ]
      },
      {
        "type": "list",
        "items": "{dock}",
        "as": "d",
        "entry": {
          "type": "stack",
          "style": "lcPanel",
          "gap": 6,
          "at": "{d.at}",
          "children": [
            {
              "type": "text",
              "style": "muted",
              "text": "{menu.title}",
              "visible": "{menu.title}"
            },
            {
              "type": "list",
              "items": "{menu.rows}",
              "as": "r",
              "gap": 5,
              "entry": {
                "type": "stack",
                "direction": "horizontal",
                "gap": 6,
                "align": "center",
                "children": [
                  {
                    "type": "image",
                    "image": "{r.icon}",
                    "size": [
                      30,
                      30
                    ],
                    "visible": "{r.icon}"
                  },
                  {
                    "type": "button",
                    "style": "lcButton",
                    "size": [
                      230,
                      0
                    ],
                    "text": "{r.key}   {r.label}   {r.note}",
                    "action": "menu",
                    "arg": "{r.id}",
                    "disabled": "{r.off}",
                    "tip": "{r.why}"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "stack",
        "anchor": "top-right",
        "offset": [
          -20,
          96
        ],
        "style": "lcPanel",
        "gap": 4,
        "size": [
          260,
          0
        ],
        "visible": "{hud.card}",
        "children": [
          {
            "type": "text",
            "style": "heading",
            "text": "{hud.card.name}"
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{hud.card.role}  {words.level} {hud.card.level}"
          },
          {
            "type": "bar",
            "style": "hp",
            "size": [
              230,
              8
            ],
            "value": "{hud.card.hp}",
            "max": "{hud.card.maxHp}"
          },
          {
            "type": "text",
            "style": "small",
            "text": "HP {hud.card.hp}/{hud.card.maxHp}"
          },
          {
            "type": "text",
            "style": "small",
            "text": "{words.atk} {hud.card.attack}   {words.def} {hud.card.defence}   {words.spd} {hud.card.speed}"
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{words.pinned}",
            "visible": "{hud.card.pinned}"
          }
        ]
      },
      {
        "type": "list",
        "anchor": "top-right",
        "offset": [
          -20,
          14
        ],
        "items": "{hud.toasts}",
        "as": "t",
        "gap": 4,
        "entry": {
          "type": "text",
          "style": "lcToast",
          "text": "{t.text}"
        }
      }
    ]
  }
}
