{
  "format": "umbra.ui",
  "version": 1,
  "back": "cafe",
  "root": {
    "type": "panel",
    "anchor": "fill",
    "style": "layer",
    "children": [
      {
        "type": "image",
        "anchor": "fill",
        "image": "{map.plan}",
        "fit": "contain",
        "visible": "{map.plan}"
      },
      {
        "type": "list",
        "items": "{map.tickets}",
        "as": "t",
        "entry": {
          "type": "stack",
          "at": "{t.at}",
          "children": [
            {
              "type": "image",
              "image": "{t.icon}",
              "size": [
                36,
                36
              ]
            },
            {
              "type": "button",
              "style": "lcTicket",
              "text": "{t.name}",
              "action": "select",
              "arg": "{t.id}",
              "selected": "{t.selected}",
              "disabled": "{t.closed}",
              "tip": "{t.markText}"
            }
          ],
          "direction": "horizontal",
          "gap": 4,
          "align": "center"
        }
      },
      {
        "type": "stack",
        "anchor": "bottom-right",
        "offset": [
          -20,
          -20
        ],
        "style": "lcPanel",
        "gap": 6,
        "size": [
          360,
          0
        ],
        "visible": "{map.panel}",
        "children": [
          {
            "type": "text",
            "style": "heading",
            "text": "{map.panel.name}"
          },
          {
            "type": "text",
            "style": "small",
            "text": "{map.panel.detail}"
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{map.panel.level}"
          },
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.enter}",
            "action": "enter",
            "arg": "{map.panel.id}",
            "visible": "{map.panel.open}"
          }
        ]
      },
      {
        "type": "stack",
        "anchor": "top-left",
        "offset": [
          20,
          14
        ],
        "style": "lcPanel",
        "gap": 4,
        "children": [
          {
            "type": "text",
            "style": "heading",
            "text": "{words.mapTitle}"
          },
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.backCafe}",
            "action": "cafe"
          },
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.settings}",
            "action": "settings"
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{map.news}",
            "visible": "{map.news}"
          }
        ]
      }
    ]
  }
}
