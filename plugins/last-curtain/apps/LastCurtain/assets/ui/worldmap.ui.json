{
  "format": "umbra.ui",
  "version": 1,
  "root": {
    "type": "panel",
    "anchor": "fill",
    "style": "lcGround",
    "children": [
      {
        "type": "stack",
        "anchor": "top-left",
        "offset": [
          36,
          26
        ],
        "direction": "horizontal",
        "gap": 12,
        "align": "center",
        "children": [
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.backCafe}",
            "action": "cafe"
          },
          {
            "type": "text",
            "style": "small",
            "text": "{map.news}",
            "visible": "{map.news}"
          }
        ]
      },
      {
        "type": "text",
        "anchor": "top",
        "offset": [
          0,
          30
        ],
        "style": "heading",
        "text": "{words.mapTitle}"
      },
      {
        "type": "stack",
        "anchor": "top-right",
        "offset": [
          -36,
          26
        ],
        "direction": "horizontal",
        "gap": 8,
        "children": [
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.settings}",
            "action": "settings"
          }
        ]
      },
      {
        "type": "panel",
        "anchor": "top-left",
        "offset": [
          36,
          96
        ],
        "size": [
          840,
          540
        ],
        "style": "lcFrame",
        "clip": true,
        "children": [
          {
            "type": "list",
            "anchor": "fill",
            "items": "{map.plans}",
            "as": "p",
            "entry": {
              "type": "image",
              "image": "{p.file}",
              "size": "{p.size}",
              "at": "{p.at}"
            }
          },
          {
            "type": "list",
            "anchor": "fill",
            "items": "{map.tickets}",
            "as": "t",
            "entry": {
              "type": "stack",
              "at": "{t.at}",
              "direction": "horizontal",
              "gap": 4,
              "align": "center",
              "children": [
                {
                  "type": "text",
                  "style": "warning",
                  "text": "{words.questMark}",
                  "visible": "{t.quest}"
                },
                {
                  "type": "image",
                  "image": "{t.icon}",
                  "size": [
                    32,
                    32
                  ]
                },
                {
                  "type": "button",
                  "style": "lcTicket",
                  "text": "{t.name}",
                  "action": "select",
                  "arg": "{t.id}",
                  "selected": "{t.selected}",
                  "disabled": "{t.closed}",
                  "tip": "{t.markText}"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "text",
        "anchor": "bottom-left",
        "offset": [
          40,
          -34
        ],
        "style": "small",
        "text": "{words.mapHint}"
      },
      {
        "type": "stack",
        "anchor": "top-right",
        "offset": [
          -36,
          96
        ],
        "size": [
          330,
          540
        ],
        "style": "lcPanel",
        "gap": 10,
        "visible": "{map.panel}",
        "children": [
          {
            "type": "text",
            "style": "heading",
            "text": "{map.panel.name}",
            "wrap": true,
            "size": [
              280,
              0
            ]
          },
          {
            "type": "text",
            "style": "muted",
            "text": "{map.panel.level}"
          },
          {
            "type": "text",
            "style": "text",
            "text": "{map.panel.detail}",
            "wrap": true,
            "size": [
              280,
              0
            ]
          },
          {
            "type": "button",
            "style": "lcButton",
            "text": "{words.enter}",
            "action": "enter",
            "arg": "{map.panel.id}",
            "visible": "{map.panel.open}",
            "size": [
              280,
              0
            ]
          }
        ]
      },
      {
        "type": "list",
        "anchor": "bottom-right",
        "offset": [
          -36,
          -12
        ],
        "items": "{map.toasts}",
        "as": "t",
        "gap": 4,
        "entry": {
          "type": "text",
          "style": "lcToast",
          "text": "{t.text}"
        }
      },
      {
        "type": "stack",
        "anchor": "top",
        "offset": [
          0,
          20
        ],
        "style": "lcPanel",
        "visible": "{map.quest}",
        "children": [
          {
            "type": "text",
            "style": "text",
            "text": "{words.questLabel}: {map.quest}",
            "wrap": true,
            "size": [
              620,
              0
            ]
          }
        ]
      }
    ]
  }
}
