{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "root": { "type": "stack", "anchor": "right", "offset": [-24, 20], "style": "panel", "size": [440, 0], "align": "center", "gap": 10, "children": [
    { "type": "text", "style": "muted", "text": "FOUND  |  {found.kind}" },
    { "type": "image", "image": "{found.picture}", "size": [160, 160] },
    { "type": "text", "style": "title", "text": "{found.name}" },
    { "type": "text", "style": "text", "text": "{found.does}", "wrap": true, "size": [400, 0], "textAlign": "center" },
    { "type": "text", "style": "muted", "text": "It goes into your bag (I)." },
    { "type": "button", "size": [200, 44], "text": "Take it", "action": "take" }
  ] }
}
