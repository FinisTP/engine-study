{
  "format": "umbra.ui",
  "version": 1,
  "modal": true,
  "dim": true,
  "root": { "type": "stack", "anchor": "center", "style": "float", "gap": 12, "align": "center", "size": [560, 0], "children": [
    { "type": "text", "style": "title", "text": "{level.name} reaches level {level.level}" },
    { "type": "text", "style": "small", "text": "Choose what to learn." },
    { "type": "list", "items": "{level.choices}", "as": "c", "gap": 8, "action": "pick", "arg": "{c.index}",
      "entry": { "type": "stack", "style": "slot", "size": [480, 0], "gap": 2, "children": [
        { "type": "text", "style": "heading", "text": "{c.name}" },
        { "type": "text", "style": "small", "text": "Power {c.power}   Cost {c.cost} HP" }
      ] } }
  ] }
}
