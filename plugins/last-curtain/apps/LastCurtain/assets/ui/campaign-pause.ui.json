        "size": [
          320,
          0
        ],
        "text": "{words.settings}",
        "action": "settings"
      },
      {
        "type": "button",
        "style": "lcButton",
        "size": [
          320,
          0
        ],
        "text": "{words.retreat}",
        "action": "retreat"
      }
    ]
