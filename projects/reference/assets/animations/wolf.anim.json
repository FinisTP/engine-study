{
  "format": "umbra.animgraph",
  "version": 1,
  "fade": 0.2,
  "states": [
    {
      "name": "dead",
      "clip": "death",
      "loop": false,
      "when": {
        "flag": "dead"
      }
    },
    {
      "name": "hit",
      "clip": "hit",
      "on": "hit"
    },
    {
      "name": "attack",
      "clip": "attack",
      "on": "attack",
      "events": [
        {
          "at": 0.8,
          "name": "swing",
          "sound": "audio/swing.wav"
        },
        {
          "at": 0.9,
          "name": "hit"
        }
      ]
    },
    {
      "name": "run",
      "clip": "run",
      "when": {
        "param": "speed",
        "above": 2.4
      },
      "rate": {
        "param": "speed",
        "per": 4.0
      },
      "events": [
        {
          "at": 0.15,
          "name": "step",
          "sound": "audio/footstep.wav",
          "effect": "vfx/dust.vfx.json"
        },
        {
          "at": 0.42,
          "name": "step",
          "sound": "audio/footstep.wav",
          "effect": "vfx/dust.vfx.json"
        }
      ]
    },
    {
      "name": "walk",
      "clip": "walk",
      "when": {
        "param": "speed",
        "above": 0.3
      },
      "rate": {
        "param": "speed",
        "per": 1.5
      },
      "events": [
        {
          "at": 0.25,
          "name": "step",
          "sound": "audio/footstep.wav",
          "effect": "vfx/dust.vfx.json"
        },
        {
          "at": 0.77,
          "name": "step",
          "sound": "audio/footstep.wav",
          "effect": "vfx/dust.vfx.json"
        }
      ]
    },
    {
      "name": "idle",
      "clip": "idle"
    }
  ]
}
