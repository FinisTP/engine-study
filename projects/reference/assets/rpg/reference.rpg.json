  "quests": [
    {
      "id": "sun_relic",
      "name": "The Stolen Relic",
      "description": "Bandits stole the Sun Relic from the village shrine. Elder Mara wants it back.",
      "objectives": [
        {
          "defeat": "bandit_leader",
          "text": "Defeat the bandit leader in the dungeon"
        },
        {
          "obtain": "sun_relic",
          "text": "Recover the Sun Relic"
        },
        {
          "talk": "elder",
          "text": "Return the relic to Elder Mara"
        }
      ],
      "failOn": [
        "death"
      ],
      "reward": {
        "xp": 120,
        "skillPoints": 1,
        "items": [
          {
            "item": "iron_sword",
            "count": 1
          }
        ]
      }
    }
  ],
  "conversations": [
    {
      "id": "elder_mara",
      "npc": "elder",
      "start": "hello",
      "nodes": [
        {
          "id": "hello",
          "speaker": "Elder Mara",
          "text": "Traveler... bandits took the Sun Relic from our shrine.",
          "choices": [
            {
              "text": "I'll get it back.",
              "next": "accepted",
              "if": [
                {
                  "quest": "sun_relic",
                  "state": "notStarted"
                }
              ],
              "do": [
                {
                  "startQuest": "sun_relic"
                }
              ]
            },
            {
              "text": "I have the relic.",
              "next": "thanks",
              "if": [
                {
                  "quest": "sun_relic",
                  "state": "active"
                },
                {
                  "hasItem": "sun_relic"
                }
              ],
              "do": [
                {
                  "take": "sun_relic"
                },
                {
                  "talk": "elder"
                }
              ]
            },
            {
              "text": "Where are the bandits again?",
              "next": "waiting",
              "if": [
                {
                  "quest": "sun_relic",
                  "state": "active"
                }
              ]
            },
            {
              "text": "How is the village?",
              "next": "done",
              "if": [
                {
                  "quest": "sun_relic",
                  "state": "completed"
                }
              ]
            },
            {
              "text": "About the relic...",
              "next": "lost",
              "if": [
                {
                  "quest": "sun_relic",
                  "state": "failed"
                }
              ]
            },
            {
              "text": "Goodbye.",
              "next": ""
            }
          ]
        },
        {
          "id": "accepted",
          "speaker": "Elder Mara",
          "text": "Their leader hides deep in the dungeon, through the purple gate east of here. Come back alive."
        },
        {
          "id": "waiting",
          "speaker": "Elder Mara",
          "text": "East of the village, through the purple gate. Their leader keeps the relic close."
        },
        {
          "id": "thanks",
          "speaker": "Elder Mara",
          "text": "The Sun Relic! You have our thanks. Take my old sword, it will serve you better than mine."
        },
        {
          "id": "done",
          "speaker": "Elder Mara",
          "text": "Quiet, thanks to you. The shrine glows again."
        },
        {
          "id": "lost",
          "speaker": "Elder Mara",
          "text": "We feared the worst when you fell. The relic is beyond our reach now."
        }
      ]
    }
  ]
}
