{
  "format": "umbra.project",
  "version": 1,
  "name": "reference",
  "title": "Umbra reference RPG",
  "plugins": [
    "rpg",
    "story",
    "living-town",
    "last-curtain",
    "turn-combat",
    "realtime-combat",
    "rpg-session",
    "third-person",
    "rpg-ui",
    "learned-ai",
    "ai-authoring",
    "web-export",
    "android-export"
  ],
  "play": [
    {
      "label": "The Last Curtain: career (cafe, then a match)",
      "program": "LastCurtain",
      "args": []
    },
    {
      "label": "The Last Curtain: faction match",
      "program": "LastCurtain",
      "args": [
        "--match"
      ]
    },
    {
      "label": "The Last Curtain: scene 'prologue'",
      "program": "LastCurtain",
      "args": [
        "--scene",
        "prologue",
        "--backdrop",
        "foyer_today"
      ]
    },
    {
      "label": "The Last Curtain: the old night",
      "program": "LastCurtain",
      "args": [
        "--night"
      ]
    },
    {
      "label": "Umbra RPG: this scene",
      "program": "Umbra",
      "args": [
        "{scene}"
      ]
    }
  ]
}
