# Source plugins (docs/adr/0005-plugins.md). A plugin is a folder plugins/<name>/ with
#   plugin.json  name, label, description, kind (game|tool), requires, requiresAny, modules, links,
#                programs (its executables, e.g. LastCurtain: the editor's Play can start them)
#   modules/<m>/ static libraries (each its own CMakeLists.txt)
#   game/ editor/ tool/  C++ compiled straight into the game, the editor or UmbraTool
#   assets/      content the project's assets may override
#   tests/       its tests       tools/  its developer tools (a CMakeLists.txt there is added)
# The project's project.json lists the plugins it uses; this file turns them on.

# Reads projects/<name>/project.json and every plugin.json; sets in the caller's scope:
#   UMBRA_PLUGINS          enabled plugin names (requirements added)
#   UMBRA_PLUGIN_DIR_<n>   its folder;  UMBRA_PLUGIN_KIND_<n>, UMBRA_PLUGIN_MODULES_<n>, UMBRA_PLUGIN_LINKS_<n>,
#   UMBRA_PLUGIN_PROGRAMS_<n> (may be empty)
# and defines UMBRA_PLUGIN_<NAME>=1 for all code (e.g. UMBRA_PLUGIN_TURN_COMBAT).
macro(umbra_load_plugins)
    # 1. What the project asks for (no project.json: every plugin).
    file(GLOB _manifests "${PROJECT_SOURCE_DIR}/plugins/*/plugin.json")
    set(_known)
    foreach(_m IN LISTS _manifests)
        file(READ "${_m}" _json)
        string(JSON _name GET "${_json}" name)
        list(APPEND _known ${_name})
        get_filename_component(UMBRA_PLUGIN_DIR_${_name} "${_m}" DIRECTORY)
        set(UMBRA_PLUGIN_JSON_${_name} "${_json}")
    endforeach()
    set(_wanted ${_known})
    if(EXISTS "${UMBRA_PROJECT_DIR}/project.json")
        file(READ "${UMBRA_PROJECT_DIR}/project.json" _project)
        string(JSON _count LENGTH "${_project}" plugins)
        set(_wanted)
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_i RANGE ${_last})
                string(JSON _p GET "${_project}" plugins ${_i})
                list(APPEND _wanted ${_p})
            endforeach()
        endif()
    endif()

    # 2. Add what they require, until nothing changes; unknown names stop the configure.
    set(UMBRA_PLUGINS)
    set(_added)
    set(_queue ${_wanted})
    while(_queue)
        list(POP_FRONT _queue _p)
        if(_p IN_LIST UMBRA_PLUGINS)
            continue()
        endif()
        if(NOT _p IN_LIST _known)
            message(FATAL_ERROR "Plugin '${_p}' (in ${UMBRA_PROJECT_DIR}/project.json) does not exist under plugins/")
        endif()
        list(APPEND UMBRA_PLUGINS ${_p})
        string(JSON _n ERROR_VARIABLE _none LENGTH "${UMBRA_PLUGIN_JSON_${_p}}" requires)
        if(_n GREATER 0)
            math(EXPR _last "${_n} - 1")
            foreach(_i RANGE ${_last})
                string(JSON _r GET "${UMBRA_PLUGIN_JSON_${_p}}" requires ${_i})
                if(NOT _r IN_LIST _wanted AND NOT _r IN_LIST _added)
                    message(STATUS "Plugin '${_p}' needs '${_r}': turned on as well")
                    list(APPEND _added ${_r})
                endif()
                list(APPEND _queue ${_r})
            endforeach()
        endif()
    endwhile()

    # 3. Per plugin: "requiresAny" groups, kind, modules, links, and the compile definition.
    foreach(_p IN LISTS UMBRA_PLUGINS)
        set(_json "${UMBRA_PLUGIN_JSON_${_p}}")
        string(JSON _groups ERROR_VARIABLE _none LENGTH "${_json}" requiresAny)
        if(_groups GREATER 0)
            math(EXPR _last "${_groups} - 1")
            foreach(_g RANGE ${_last})
                string(JSON _group GET "${_json}" requiresAny ${_g})
                string(JSON _len LENGTH "${_group}")
                math(EXPR _glast "${_len} - 1")
                set(_found FALSE)
                set(_names)
                foreach(_i RANGE ${_glast})
                    string(JSON _r GET "${_group}" ${_i})
                    list(APPEND _names ${_r})
                    if(_r IN_LIST UMBRA_PLUGINS)
                        set(_found TRUE)
                    endif()
                endforeach()
                if(NOT _found)
                    list(JOIN _names " or " _names)
                    message(FATAL_ERROR "Plugin '${_p}' needs ${_names}: add one to ${UMBRA_PROJECT_DIR}/project.json")
                endif()
            endforeach()
        endif()
        string(JSON UMBRA_PLUGIN_KIND_${_p} GET "${_json}" kind)
        foreach(_field modules links programs)
            set(_list)
            string(JSON _n ERROR_VARIABLE _none LENGTH "${_json}" ${_field})
            if(_n GREATER 0)
                math(EXPR _last "${_n} - 1")
                foreach(_i RANGE ${_last})
                    string(JSON _v GET "${_json}" ${_field} ${_i})
                    list(APPEND _list ${_v})
                endforeach()
            endif()
            string(TOUPPER ${_field} _FIELD)
            set(UMBRA_PLUGIN_${_FIELD}_${_p} ${_list})
        endforeach()
        string(TOUPPER "${_p}" _define)
        string(REPLACE "-" "_" _define "${_define}")
        add_compile_definitions(UMBRA_PLUGIN_${_define}=1)
    endforeach()
    list(JOIN UMBRA_PLUGINS ", " _shown)
    message(STATUS "Project ${UMBRA_PROJECT_DIR}: plugins ${_shown}")
endmacro()

# Adds the modules of every enabled plugin (KIND game only: the browser build).
function(umbra_add_plugin_modules)
    cmake_parse_arguments(ARG "" "KIND" "" ${ARGN})
    foreach(p IN LISTS UMBRA_PLUGINS)
        if(ARG_KIND AND NOT UMBRA_PLUGIN_KIND_${p} STREQUAL ARG_KIND)
            continue()
        endif()
        foreach(m IN LISTS UMBRA_PLUGIN_MODULES_${p})
            add_subdirectory(${UMBRA_PLUGIN_DIR_${p}}/modules/${m} ${CMAKE_BINARY_DIR}/plugins/${p}/${m})
        endforeach()
    endforeach()
endfunction()

# Adds every enabled plugin's tests/ and tools/ folders that have a CMakeLists.txt.
function(umbra_add_plugin_folders folder)
    foreach(p IN LISTS UMBRA_PLUGINS)
        if(EXISTS ${UMBRA_PLUGIN_DIR_${p}}/${folder}/CMakeLists.txt)
            add_subdirectory(${UMBRA_PLUGIN_DIR_${p}}/${folder} ${CMAKE_BINARY_DIR}/plugins/${p}/${folder})
        endif()
    endforeach()
endfunction()

# Compiles every enabled plugin's <host>/ sources (game, editor or tool) into `target` and links
# that plugin's libraries. Sources go into the program itself, so their self-registrations
# (UMBRA_COMPONENT, UMBRA_EDITOR_PANEL, UMBRA_TOOL_COMMAND) are never dropped by the linker.
function(umbra_add_plugin_sources target host)
    foreach(p IN LISTS UMBRA_PLUGINS)
        file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${UMBRA_PLUGIN_DIR_${p}}/${host}/*.cpp" "${UMBRA_PLUGIN_DIR_${p}}/${host}/*.hpp")
        if(sources)
            target_sources(${target} PRIVATE ${sources})
            target_link_libraries(${target} PRIVATE ${UMBRA_PLUGIN_LINKS_${p}})
        endif()
    endforeach()
endfunction()

# Stops the configure if a program's required plugins are not on.
function(umbra_require_plugins what)
    foreach(p IN LISTS ARGN)
        if(NOT p IN_LIST UMBRA_PLUGINS)
            message(FATAL_ERROR "${what} needs the plugin '${p}': add it to ${UMBRA_PROJECT_DIR}/project.json")
        endif()
    endforeach()
endfunction()

# The enabled plugins' assets folders, for packaging and the web asset pack.
function(umbra_plugin_asset_dirs out)
    set(dirs)
    foreach(p IN LISTS UMBRA_PLUGINS)
        if(IS_DIRECTORY ${UMBRA_PLUGIN_DIR_${p}}/assets)
            list(APPEND dirs ${UMBRA_PLUGIN_DIR_${p}}/assets)
        endif()
    endforeach()
    set(${out} ${dirs} PARENT_SCOPE)
endfunction()
