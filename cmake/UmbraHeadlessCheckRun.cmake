# Runs at test time: fails if any target in REPORT links a library matching FORBIDDEN.
file(STRINGS "${REPORT}" lines)
set(failed FALSE)
foreach(line IN LISTS lines)
    string(REPLACE "=" ";" parts "${line}")
    list(GET parts 0 target)
    list(SUBLIST parts 1 -1 links)
    foreach(link IN LISTS links)
        if(link MATCHES "${FORBIDDEN}")
            message(SEND_ERROR "${target} must stay headless but links ${link}")
            set(failed TRUE)
        endif()
    endforeach()
    list(LENGTH links count)
    message(STATUS "${target}: ${count} linked targets checked")
endforeach()
if(failed)
    message(FATAL_ERROR "Headless dependency check failed")
endif()
