{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 - MSVC",
      "generator": "Ninja Multi-Config",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "town-model",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows x64 - Clang",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows x64 - MSVC AddressSanitizer",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "UMBRA_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-release-j4",
      "displayName": "Release, 4 compilers at once (if Windows blocks cl.exe)",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-msvc-check",
      "displayName": "Release: build, test, update known-good",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "targets": [ "UmbraCheck" ],
      "jobs": 4
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-asan-debug",
      "configurePreset": "windows-msvc-asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "windows-msvc-asan-debug",
      "configurePreset": "windows-msvc-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    }
  ]
}
